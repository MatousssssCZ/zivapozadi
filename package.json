{
  "name": "zimni-scena",
  "productName": "Zimní scéna",
  "version": "0.1.0",
  "description": "Editor a exportér animovaných zimních scén (2D, pevná kamera, deterministická simulace)",
  "main": "dist-electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build:web": "node scripts/build-web.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "demo:generate": "tsx scripts/generate-demo.ts",
    "export:cli": "tsx scripts/export-cli.ts",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "test:e2e": "npm run build && node tests/e2e/electron.e2e.cjs",
    "assets:generate": "tsx scripts/generate-assets.ts",
    "test:e2e:postavy": "npm run build && node tests/e2e/characters.e2e.cjs",
    "parts:generate": "tsx scripts/generate-painted-parts.ts"
  },
  "build": {
    "appId": "cz.zimniscena.editor",
    "productName": "Zimní scéna",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "demo",
        "to": "demo"
      },
      {
        "from": "resources/builtin",
        "to": "builtin"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "mp4-muxer": "^5.2.2",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "45.2.3",
    "electron-builder": "26.0.12",
    "esbuild": "0.27.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.0.15"
  }
}
